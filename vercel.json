{
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "https://earthapi.hellosquare.app/v1/:path*"
    },
    {
      "source": "/((?!v1/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
