{
  // Typechecks the app and its tests: `npx tsc --noEmit`. Vite builds without tsc, so this is the
  // only place types are enforced; keep `include` and `types` in step with what runs.
  "compilerOptions": {
    "module": "esnext",
    "target": "es2020",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["vitest/globals", "@testing-library/jest-dom/vitest"],
    "jsx": "react-jsx",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["src"]
}
